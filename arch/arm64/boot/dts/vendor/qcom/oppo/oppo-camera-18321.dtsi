  clocks = <&clock_mmss MCLK0_CLK_SRC>,
   <&clock_mmss MMSS_CAMSS_MCLK0_CLK>;
  clock-names = "cam_src_clk", "cam_clk";
  qcom,clock-rates = <24000000 0>;
 };
};

/* 4.4 gpio@c300 (GPIO7) 子节点配置的 4.19 pinctrl 等价物 (eeprom3/5 + dvdd) */
&pm660l_gpios {
 oppo_cam_gpio7 {
  oppo_cam_gpio7_default: oppo_cam_gpio7_default {
   pins = "gpio7";
   function = "normal";
   power-source = <0>;
   drive-push-pull;
   output-low;
   bias-disable;
  };
 };
};
