# Platform
CONFIG_MACH_REALME_RMX1801=y

# TOF sensor (ST VL53L0 on cci bus, stock 18321 tof0 node)
CONFIG_INPUT_STMVL53L0=y

# Touchscreen
CONFIG_TOUCHPANEL_MULTI_NOFLASH=y
CONFIG_TOUCHPANEL_NOVA=y
CONFIG_TOUCHPANEL_NOVA_NT36672_NOFLASH=y
CONFIG_TOUCHPANEL_HIMAX=y
CONFIG_TOUCHPANEL_HIMAX_HX83112A_NOFLASH=y
# CONFIG_TOUCHPANEL_SYNAPTICS is not set
# CONFIG_TOUCHPANEL_SYNAPTICS_S3508 is not set
# CONFIG_TOUCHPANEL_SYNAPTICS_S3320 is not set
